{
  "name": "enhance-chat",
  "displayName": "Enhance Chat",
  "description": "开源版 EnhanceChat - 让 AI 停下来听你说话",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicepkg/windsurf-chat-open"
  },
  "publisher": "enhance-chat",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "EnhanceChatOpenPanel",
          "title": "ChatOpen-A",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "EnhanceChatOpenPanelB",
          "title": "ChatOpen-B",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "EnhanceChatOpenPanel": [
        {
          "type": "webview",
          "id": "EnhanceChatOpen.panel",
          "name": "AI-A",
          "icon": "$(comment-discussion)"
        }
      ],
      "EnhanceChatOpenPanelB": [
        {
          "type": "webview",
          "id": "EnhanceChatOpen.panelB",
          "name": "AI-B",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "EnhanceChatOpen.focus",
        "title": "EnhanceChatOpen: 聚焦面板"
      },
      {
        "command": "EnhanceChatOpen.focusB",
        "title": "EnhanceChatOpen: 聚焦面板 B"
      },
      {
        "command": "EnhanceChatOpen.setup",
        "title": "EnhanceChatOpen: 初始化工作区"
      }
    ],
    "keybindings": [
      {
        "command": "EnhanceChatOpen.focus",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package --out releases/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}